{
  // Type-checks the test code, which Vitest and Playwright otherwise run without checking.
  // Not used for building: the extension itself compiles with tsconfig.json.
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["test", "e2e", "vitest.config.ts", "playwright.config.ts"]
}
